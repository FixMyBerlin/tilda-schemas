{
  "name": "@tilda-geo/bicycle-infrastructure-reconciliation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cross-check the Tilda LUA bicycle-infrastructure pipeline against the shared schemas and the TypeScript library, using a static Berlin reference.",
  "scripts": {
    "overpass:query": "bun scripts/build-overpass-query.ts",
    "overpass:download": "bun scripts/download-overpass.ts",
    "overpass:derive-tags": "bun --smol scripts/derive-overpass-tags.ts",
    "clip": "bun scripts/clip-tilda-export.ts",
    "check": "bun src/check.ts",
    "type-check": "tsc --noEmit",
    "compare": "bun src/compare.ts",
    "validate-export": "bun src/validate-export.ts"
  },
  "dependencies": {
    "@tilda-geo/bicycle-infrastructure": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/bun": "latest"
  }
}
