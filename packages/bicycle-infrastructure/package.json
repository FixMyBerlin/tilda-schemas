{
  "name": "@tilda-geo/bicycle-infrastructure",
  "version": "0.2.0",
  "description": "TypeScript port of TILDA's LUA bicycle-infrastructure processing (category + surface/protection/oneway derivations). Runs on plain OSM tag objects (e.g. live Overpass data).",
  "keywords": [
    "bicycle",
    "bicycle-infrastructure",
    "cycling",
    "openstreetmap",
    "osm",
    "tilda"
  ],
  "homepage": "https://fixmyberlin.github.io/tilda-schemas/",
  "bugs": {
    "url": "https://github.com/FixMyBerlin/tilda-schemas/issues"
  },
  "license": "ISC",
  "author": "Tobias Jordans",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FixMyBerlin/tilda-schemas.git",
    "directory": "packages/bicycle-infrastructure"
  },
  "files": [
    "dist",
    "NOTICE.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "type-check": "tsc --noEmit",
    "test-run": "bun test",
    "check-exports": "publint && attw --pack . --profile esm-only",
    "prepublishOnly": "bun run build"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/bun": "latest",
    "publint": "^0.3.24",
    "tsup": "^8.5.1",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=18"
  }
}
