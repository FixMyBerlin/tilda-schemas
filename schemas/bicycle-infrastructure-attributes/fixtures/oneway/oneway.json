    },
    "select": { "side": "self" },
    "expect": { "oneway": "car_not_bike", "_lineReversed": true }
  },
  {
    "name": "oneway:bicycle=no on a oneway=yes way → car_not_bike, line with the way",
    "input": {
      "highway": "cycleway",
      "traffic_sign": "DE:237",
      "oneway": "yes",
      "oneway:bicycle": "no"
    },
    "select": { "side": "self" },
    "expect": { "oneway": "car_not_bike", "_lineReversed": false }
  },
  {
    "name": "bicycle road on a oneway=-1 road with oneway:bicycle=no → car_not_bike",
