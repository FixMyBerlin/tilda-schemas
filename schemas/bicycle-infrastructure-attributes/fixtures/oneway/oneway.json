    "select": { "side": "self" },
    "expect": { "oneway": "yes", "_lineReversed": true }
  },
  {
    "name": "oneway:bicycle=no on a oneway=-1 way → car_not_bike, line along the motor direction (tilda-geo ef8fcdebf)",
