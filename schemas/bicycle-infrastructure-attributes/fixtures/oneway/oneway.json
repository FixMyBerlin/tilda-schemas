[
  {
    "name": "explicit oneway=yes is kept",
    "input": { "highway": "cycleway", "traffic_sign": "DE:237", "oneway": "yes" },
    "select": { "side": "self" },
    "expect": { "oneway": "yes" }
  },
  {
    "name": "explicit oneway=no is kept",
    "input": { "highway": "cycleway", "traffic_sign": "DE:237", "oneway": "no" },
    "select": { "side": "self" },
    "expect": { "oneway": "no" }
  },
  {
    "name": "oneway:bicycle=yes wins",
    "input": { "highway": "cycleway", "traffic_sign": "DE:237", "oneway:bicycle": "yes" },
    "select": { "side": "self" },
    "expect": { "oneway": "yes" }
  },
  {
    "name": "oneway:bicycle=no on a car-oneway → car_not_bike",
    "input": {
      "highway": "cycleway",
      "traffic_sign": "DE:237",
      "oneway": "yes",
      "oneway:bicycle": "no"
    },
    "select": { "side": "self" },
    "expect": { "oneway": "car_not_bike" }
  },
  {
    "name": "separated cycleway without oneway → assumed_no (implicitOneWay=false)",
    "input": { "highway": "cycleway", "traffic_sign": "DE:237" },
    "select": { "side": "self" },
    "expect": { "oneway": "assumed_no" }
  },
  {
    "name": "shared foot+cycleway without oneway → implicit_yes (lane-like)",
    "input": { "highway": "cycleway", "traffic_sign": "DE:240" },
    "select": { "side": "self" },
    "expect": { "oneway": "implicit_yes" }
  },
  {
    "name": "advisory lane without oneway → implicit_yes",
    "input": {
      "highway": "secondary",
      "cycleway:right": "lane",
      "cycleway:right:lane": "advisory"
    },
    "select": { "side": "right", "prefix": "cycleway" },
    "expect": { "oneway": "implicit_yes" }
  },
  {
    "name": "oneway=-1 on a separate way is an explicit oneway against the way",
    "osm": "follows tilda-geo-private#34 (not merged yet)",
    "input": { "highway": "cycleway", "is_sidepath": "yes", "oneway": "-1" },
    "select": { "side": "self" },
    "expect": { "oneway": "yes", "_lineReversed": true, "offset": null }
  },
  {
    "name": "oneway=1 is the same as oneway=yes",
    "input": { "highway": "cycleway", "traffic_sign": "DE:237", "oneway": "1" },
    "select": { "side": "self" },
    "expect": { "oneway": "yes", "_lineReversed": false }
  },
  {
    "name": "oneway=yes runs with the way",
    "input": { "highway": "cycleway", "traffic_sign": "DE:237", "oneway": "yes" },
    "select": { "side": "self" },
    "expect": { "oneway": "yes", "_lineReversed": false }
  },
  {
    "name": "oneway:bicycle=-1 is an explicit oneway against the way",
