[
  {
    "name": "cycleway:both=track creates a left AND right separated cycleway",
    "input": { "highway": "residential", "cycleway:both": "track" },
    "expectFeatures": [
      {
        "select": { "side": "left", "prefix": "cycleway" },
        "expect": { "category": "cycleway_adjoining" }
      },
      {
        "select": { "side": "right", "prefix": "cycleway" },
        "expect": { "category": "cycleway_adjoining" }
      }
    ]
  },
  {
    "name": "cycleway:right sub-tags unnest onto the right side (surface)",
    "input": {
      "highway": "secondary",
      "cycleway:right": "track",
      "cycleway:right:traffic_sign": "DE:237",
      "cycleway:right:surface": "asphalt"
    },
    "select": { "side": "right", "prefix": "cycleway" },
    "expect": { "category": "cycleway_adjoining", "surface": "asphalt" }
  },
  {
    "name": "sidewalk:right with bicycle=yes → footwayBicycleYes on the sidewalk side",
    "input": { "highway": "residential", "sidewalk:right": "yes", "sidewalk:right:bicycle": "yes" },
    "select": { "side": "right", "prefix": "sidewalk" },
    "expect": { "category": "footwayBicycleYes_adjoining" }
  },
  {
    "name": "cycleway=opposite_track on a oneway road → left track, right none",
    "input": { "highway": "residential", "oneway": "yes", "cycleway": "opposite_track" },
    "expectFeatures": [
      {
        "select": { "side": "left", "prefix": "cycleway" },
        "expect": { "category": "cycleway_adjoining" }
      }
    ]
  },
  {
    "name": "cycleway=opposite_lane on a oneway=yes road → left contraflow lane with cycleway:left:oneway=-1",
    "osm": "tilda-geo 6ec40d600, bac701775",
    "input": { "highway": "residential", "oneway": "yes", "cycleway": "opposite_lane" },
    "expectFeatures": [
      {
        "select": { "side": "left", "prefix": "cycleway" },
        "expect": {
          "category": "cyclewayOnHighway_advisoryOrExclusive",
          "oneway": "yes",
          "_lineReversed": true
        }
      },
      { "select": { "side": "right", "prefix": "cycleway" }, "expect": { "category": "data_no" } }
    ]
  },
  {
    "name": "cycleway=opposite_lane on a oneway=-1 road is mirrored: right contraflow lane with cycleway:right:oneway=yes",
    "osm": "tilda-geo 6ec40d600, bac701775",
    "input": { "highway": "residential", "oneway": "-1", "cycleway": "opposite_lane" },
    "expectFeatures": [
      {
        "select": { "side": "right", "prefix": "cycleway" },
        "expect": {
          "category": "cyclewayOnHighway_advisoryOrExclusive",
          "oneway": "yes",
          "_lineReversed": false
        }
      },
      { "select": { "side": "left", "prefix": "cycleway" }, "expect": { "category": "data_no" } }
    ]
  },
  {
    "name": "cycleway=opposite_track on a oneway=-1 road is mirrored",
    "osm": "tilda-geo 6ec40d600, bac701775",
    "input": { "highway": "residential", "oneway": "-1", "cycleway": "opposite_track" },
    "expectFeatures": [
      {
        "select": { "side": "right", "prefix": "cycleway" },
        "expect": { "category": "cycleway_adjoining", "oneway": "yes", "_lineReversed": false }
      },
      { "select": { "side": "left", "prefix": "cycleway" }, "expect": { "category": "data_no" } }
    ]
  },
  {
    "name": "cycleway=opposite on a oneway=-1 road means no lane, bikes may ride both ways",
    "osm": "tilda-geo 6ec40d600, bac701775",
    "input": { "highway": "residential", "oneway": "-1", "cycleway": "opposite" },
    "expectFeatures": [
      { "select": { "side": "left", "prefix": "cycleway" }, "expect": { "category": "data_no" } },
      { "select": { "side": "right", "prefix": "cycleway" }, "expect": { "category": "data_no" } }
    ]
  },
  {
    "name": "cycleway=opposite_lane keeps an explicit cycleway:left:oneway",
    "osm": "tilda-geo 6ec40d600, bac701775",
    "input": {
      "highway": "residential",
      "oneway": "yes",
      "cycleway": "opposite_lane",
      "cycleway:left:oneway": "no"
    },
    "select": { "side": "left", "prefix": "cycleway" },
    "expect": { "oneway": "no", "_lineReversed": true }
  }
]
