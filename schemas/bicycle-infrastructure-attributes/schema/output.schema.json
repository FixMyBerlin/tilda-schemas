{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://fixmyberlin.github.io/tilda-schemas/schemas/bicycle-infrastructure-attributes/output.schema.json",
  "title": "TILDA Bicycle Infrastructure Attributes (draft)",
  "description": "DRAFT \u2014 controlled vocabulary for non-category output keys. Not yet a published schema. Controlled vocabulary for each output key of one processed bikelane feature. Source of truth for both the LUA pipeline and the TypeScript library. Ported from tilda-geo processing/topics/roads_bikelanes. `null` means the key is absent/not derivable.",
  "type": "object",
  "properties": {
    "category": {
      "description": "Bicycle infrastructure category. `*_adjoining|_isolated|_adjoiningOrIsolated` are sidepath subcategories.",
      "type": "string",
      "enum": [
        "pedestrianAreaBicycleYes",
        "bicycleRoad",
        "bicycleRoad_vehicleDestination",
        "footAndCyclewayShared_adjoining",
        "footAndCyclewayShared_isolated",
        "footAndCyclewayShared_adjoiningOrIsolated",
        "footAndCyclewaySegregated_adjoining",
        "footAndCyclewaySegregated_isolated",
        "footAndCyclewaySegregated_adjoiningOrIsolated",
        "footwayBicycleYes_adjoining",
        "footwayBicycleYes_isolated",
        "footwayBicycleYes_adjoiningOrIsolated",
        "cycleway_adjoining",
        "cycleway_isolated",
        "cycleway_adjoiningOrIsolated",
        "crossing",
        "cyclewayLink",
        "cyclewayOnHighway_advisory",
        "cyclewayOnHighway_exclusive",
        "cyclewayOnHighway_advisoryOrExclusive",
        "sharedMotorVehicleLane",
        "cyclewayOnHighwayBetweenLanes",
        "cyclewayOnHighwayProtected",
        "sharedBusLaneBusWithBike",
        "sharedBusLaneBikeWithBus",
        "needsClarification",
        "data_no",
        "separate_geometry",
        "not_expected"
      ]
    },
    "_side": {
      "type": "string",
      "enum": ["self", "left", "right"]
    },
    "_prefix": {
      "type": ["string", "null"],
      "enum": ["cycleway", "sidewalk", null]
    },
    "_infrastructureExists": {
      "type": "boolean"
    },
    "oneway": {
      "type": ["string", "null"],
      "enum": ["yes", "no", "car_not_bike", "assumed_no", "implicit_yes", null]
    },
    "surface": {
      "type": ["string", "null"],
      "enum": [
        "asphalt",
        "paved",
        "unpaved",
        "concrete",
        "concrete:plates",
        "concrete:lanes",
        "paving_stones",
        "paving_stones:lanes",
        "sett",
        "bricks",
        "stone",
        "ground",
        "grass",
        "sand",
        "compacted",
        "fine_gravel",
        "gravel",
        "pebblestone",
        "wood",
        "woodchips",
        "metal",
        "metal_grid",
        "plastic",
        "rubber",
        "grass_paver",
        "mosaic_sett",
        "small_sett",
        "large_sett",
        null
      ]
    },
    "surface_source": {
      "type": ["string", "null"],
      "enum": ["tag", "parent_highway_tag", null]
    },
    "surface_confidence": {
      "type": ["string", "null"],
      "enum": ["high", null]
    },
    "smoothness": {
      "type": ["string", "null"],
      "enum": ["excellent", "good", "intermediate", "bad", "very_bad", null]
    },
    "smoothness_source": {
      "description": "May be prefixed with `parent_highway_` when copied from the parent highway.",
      "type": ["string", "null"],
      "enum": [
        "tag",
        "tag_normalized",
        "surface_to_smoothness",
        "tracktype_to_smoothness",
        "mtb:scale_to_smoothness",
        "parent_highway_tag",
        "parent_highway_tag_normalized",
        "parent_highway_surface_to_smoothness",
        "parent_highway_tracktype_to_smoothness",
        "parent_highway_mtb:scale_to_smoothness",
        null
      ]
    },
    "smoothness_confidence": {
      "type": ["string", "null"],
      "enum": ["high", "medium", null]
    },
    "separation_left": {
      "$ref": "#/$defs/separation"
    },
    "separation_right": {
      "$ref": "#/$defs/separation"
    },
    "buffer_left": {
      "type": ["number", "null"]
    },
    "buffer_right": {
      "type": ["number", "null"]
    },
    "marking_left": {
      "$ref": "#/$defs/marking"
    },
    "marking_right": {
      "$ref": "#/$defs/marking"
    },
    "traffic_mode_left": {
      "$ref": "#/$defs/trafficMode"
    },
    "traffic_mode_right": {
      "$ref": "#/$defs/trafficMode"
    },
    "surface_color": {
      "type": ["string", "null"],
      "enum": ["red", "green", "red;green", "no", null]
    },
    "traffic_sign": {
      "type": ["string", "null"]
    },
    "width": {
      "type": ["number", "null"]
    }
  },
  "required": ["category", "_side", "_infrastructureExists"],
  "$defs": {
    "separation": {
      "type": ["string", "null"],
      "enum": [
        "no",
        "bollard",
        "flex_post",
        "vertical_panel",
        "studs",
        "bump",
        "planter",
        "kerb",
        "fence",
        "jersey_barrier",
        "guard_rail",
        "structure",
        "ditch",
        "greenery",
        "hedge",
        "tree_row",
        "cone",
        "kerb;parking_lane",
        "kerb;bollard",
        "yes",
        null
      ]
    },
    "marking": {
      "type": ["string", "null"],
      "enum": [
        "solid_line",
        "dashed_line",
        "double_solid_line",
        "barred_area",
        "pictogram",
        "surface",
        null
      ]
    },
    "trafficMode": {
      "type": ["string", "null"],
      "enum": ["no", "motor_vehicle", "parking", "psv", "bicycle", "foot", null]
    }
  }
}
