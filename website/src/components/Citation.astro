---
import { PUBLIC_CONCEPT_DOI } from 'astro:env/client'

interface Props {
  compact?: boolean
}

const { compact = false } = Astro.props
const doi = PUBLIC_CONCEPT_DOI?.trim()
const doiUrl = doi ? `https://doi.org/${doi}` : null
---

<aside class:list={['citation', compact && 'citation--compact']}>
  <h2>Citation</h2>
  {
    doiUrl ? (
      <p>
        <a href={doiUrl}>
          <img
            alt={`DOI ${doi}`}
            src={`https://zenodo.org/badge/DOI/${doi}.svg`}
          />
        </a>
      </p>
    ) : (
      <p class="muted">
        Zenodo DOI pending — first citable release will add a concept DOI here. See{' '}
        <a href={`${import.meta.env.BASE_URL}publishing/`}>publishing notes</a>.
      </p>
    )
  }
  <p>
    FixMyCity. <em>TILDA Schemas</em>. GitHub.
    <a href="https://github.com/FixMyBerlin/tilda-schemas">https://github.com/FixMyBerlin/tilda-schemas</a>
  </p>
</aside>

<style>
  .citation {
    border: 1px solid #d0d7de;
    border-radius: 8px;
    padding: 1rem 1.25rem;
    margin: 1.5rem 0;
    background: #f6f8fa;
  }
  .citation h2 {
    margin: 0 0 0.5rem;
    font-size: 1rem;
  }
  .citation--compact {
    font-size: 0.9rem;
  }
  .muted {
    color: #57606a;
  }
</style>
