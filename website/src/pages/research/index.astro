---
import Base from '../../layouts/Base.astro'
import { getCollection } from 'astro:content'

const items = await getCollection('research')
---

<Base title="Research — TILDA Schemas" description="Related research">
  <h1>Related research</h1>
  <ul class="card-list">
    {
      items.map((item) => (
        <li>
          {item.data.url ? (
            <a href={item.data.url}>
              <strong>{item.data.title}</strong>
            </a>
          ) : (
            <strong>{item.data.title}</strong>
          )}
          {item.data.description && <div>{item.data.description}</div>}
        </li>
      ))
    }
  </ul>
</Base>
