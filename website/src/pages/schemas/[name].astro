---
import Base from '../../layouts/Base.astro'
import Citation from '../../components/Citation.astro'
import { loadSchemaMetas } from '../../lib/schemas'

export function getStaticPaths() {
  return loadSchemaMetas().map((s) => ({
    params: { name: s.name },
    props: { schema: s },
  }))
}

const { schema } = Astro.props
const githubBase = `https://github.com/FixMyBerlin/tilda-schemas/tree/main/schemas/${schema.name}`
---

<Base title={`${schema.title} — TILDA Schemas`} description={schema.description}>
  <p>
    <a href={`${import.meta.env.BASE_URL}schemas/`}>← Schemas</a>
  </p>
  <h1>{schema.title}</h1>
  <p>
    <span class:list={['badge', schema.status !== 'published' && 'badge--draft']}>{schema.status}</span>
    {' '}
    <small>v{schema.version}</small>
  </p>
  <p class="lead">{schema.description}</p>

  <ul>
    {
      schema.schema && (
        <li>
          JSON Schema:{' '}
          <a href={`${githubBase}/${schema.schema}`}>{schema.schema}</a>
        </li>
      )
    }
    {
      schema.fixtures && (
        <li>
          Fixtures:{' '}
          <a href={`${githubBase}/${schema.fixtures}`}>{schema.fixtures}</a>
        </li>
      )
    }
    {
      schema.changelog && (
        <li>
          Changelog:{' '}
          <a href={`${githubBase}/${schema.changelog}`}>{schema.changelog}</a>
        </li>
      )
    }
    <li>
      Folder: <a href={githubBase}>{`schemas/${schema.name}`}</a>
    </li>
  </ul>

  <Citation compact />
</Base>
