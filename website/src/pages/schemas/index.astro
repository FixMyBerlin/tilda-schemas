---
import Base from '../../layouts/Base.astro'
import { loadSchemaMetas } from '../../lib/schemas'

const schemas = loadSchemaMetas()
const base = import.meta.env.BASE_URL
---

<Base title="Schemas — TILDA Schemas" description="List of TILDA schemas">
  <h1>Schemas</h1>
  <ul class="card-list">
    {
      schemas.map((s) => (
        <li>
          <span class:list={['badge', s.status !== 'published' && 'badge--draft']}>{s.status}</span>
          {' '}
          <a href={`${base}schemas/${s.name}/`}>
            <strong>{s.title}</strong>
          </a>
          <div>{s.description}</div>
          <small>v{s.version}</small>
        </li>
      ))
    }
  </ul>
</Base>
